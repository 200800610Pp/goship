# 环境变量示例（复制为 .env 使用）
# 服务器会自动读取项目根目录的 .env 文件

# 监听端口
PORT=8787
# 绑定地址（服务器部署用 0.0.0.0）
HOST=127.0.0.1

# 会话签名密钥（生产环境必须设置为长随机串）
SESSION_SECRET=please-change-me

# 站点公开地址（影响 sitemap.xml）
SITE_URL=http://localhost:8787

# demo | production（production 关闭演示横幅）
GOSHIP_MODE=demo

# ── Waffo Pancake 收款（Webhook 验签公钥）──
# 方式一：环境变量（换行写成 \n）
WAFFO_PUBLIC_KEY=
# 方式二（推荐）：把公钥保存为 data/waffo-public.pem 文件
# 生产环境公钥可另存为 data/waffo-public-prod.pem，两把会同时生效
# 验签时间容差（毫秒），默认 24 小时，用于覆盖平台的重试窗口
# WAFFO_SIG_TOLERANCE_MS=86400000

# 注册邀请码（非空则注册必须填写）
INVITE_CODE=

# 联系邮箱
SUPPORT_EMAIL=support@example.com
